# Copy to `.env.docker` on the server and fill in real values:
#   cp .env.docker.example .env.docker && chmod 600 .env.docker
#
# .env.docker is git-ignored (.gitignore covers `.env*`) and excluded from the
# Docker build context (.dockerignore), so it is never baked into an image
# layer. It is read at container start by docker compose `env_file`.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Admin panel password. Doubles as the HMAC secret for the admin session cookie
# (src/lib/auth.ts), so make it long and random — not a memorable password:
#   openssl rand -base64 36
# The container refuses to start if this is empty.
#
# Changing this value invalidates every issued session cookie immediately — it
# is the revocation mechanism if you ever suspect a session was stolen.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Personal access token for the GitHub contribution graph (/api/github).
# A classic token with NO scopes ticked is enough for public data — it only
# raises the rate limit. Leave empty to run unauthenticated.
GITHUB_TOKEN=

# NOTE: GITHUB_ADMIN_USERNAME is no longer read. The GitHub sign-in route
# accepted an unverified username from the request body and handed out an admin
# session for it, so it is disabled and returns 501. Password login is the only
# way into the admin panel. See src/app/api/auth/github/route.ts and DOCKER.md
# section 10.
