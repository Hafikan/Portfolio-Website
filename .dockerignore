# Build context allowlist-by-exclusion. Anything listed here never reaches the
# Docker daemon, so it can't end up in an image layer or leak via `docker history`.

# --- secrets / credentials (never bake these into an image) ---
.env
.env.*
*.pem
*.key
*.crt
*.p12
serviceAccount*.json
firebase-adminsdk*.json
secrets/

# --- version control history (contains every past commit, incl. deleted files) ---
.git
.gitignore
.gitattributes
.github

# --- dependencies & build output (rebuilt inside the image) ---
node_modules
.next
out
build
coverage
.pnp
.pnp.*
.yarn

# --- runtime/user data (lives in volumes, not in the image) ---
public/uploads

# --- local tooling / editor / OS noise ---
.claude
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# --- logs & scratch ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
diff.log

# --- typescript incremental cache ---
*.tsbuildinfo
next-env.d.ts

# --- docs & deploy metadata not needed at build time ---
Dockerfile
docker-compose*.yml
.dockerignore
DOCKER.md
README.md
LICENSE
AGENTS.md
CLAUDE.md

# --- unused fixtures / third-party config left over from the upstream fork ---
events.json
events2.json
torvalds.json
firebase.json
firestore.rules
.vercel
